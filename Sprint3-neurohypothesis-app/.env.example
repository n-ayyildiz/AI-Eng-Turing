# =============================================================================
# HypGen v2 — Environment variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.
# =============================================================================

# Required: OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: override log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Optional: path for the loguru log file (relative to project root)
LOG_FILE=logs/hypgen_v2.log

# Optional: path for the SQLite database (relative to project root)
SQLITE_PATH=hypgen.db

# Optional: path for Chroma vector store directory
CHROMA_DIR=chroma_db

# Optional: path for exported PDF / CSV files
EXPORTS_DIR=exports